# The vdh agent environment for the CODEX profile. Byte-for-byte the same
# target as Dockerfile — same bases, same /app/src, same /app/outputs —
# differing in exactly one thing: which agent CLI is baked. That single
# difference is the whole point. tally's claim that a stage's vendor is a
# property the runtime enforces is only checkable if two stages can run the
# same surface under different vendors, and an image per vendor is the honest
# way to say so.
#
# It does NOT carry the ground truth, for the same reason Dockerfile does not:
# the report stage is scored on recall and precision against a key that exists
# only in the gate image.
#
# Baked rather than installed at trial time because tally runs this environment
# no-network, and Harbor's install step reaches the package mirror BEFORE the
# agent phase opens its allowlist. Codex.install() returns early when
# _INSTALL_CHECK_COMMAND (`command -v codex`) exits 0 and no --agent-version
# was pinned, so nothing is fetched during a trial.
FROM node:22-bookworm@sha256:8a34c4ab3ea2c5cd194f07e317b2a8f09461d3c8b05c4e34c8ccd56d56024c4d AS cli
RUN npm install -g @openai/codex@0.145.0

# codex ships a node wrapper (bin/codex.js) that dispatches to a vendored
# native binary, unlike claude.exe which IS the binary. So node is load-bearing
# here rather than a convenience, and the whole package tree comes with it: the
# vendored codex locates its bundled rg and zsh relative to its own path.
FROM python:3.12-bookworm@sha256:581429e3df12d76e6af4be5ab7d0e7fc2013eb57dc23d2de691411c8efdbb970
COPY --from=cli /usr/local/bin/node /usr/local/bin/node
COPY --from=cli /usr/local/lib/node_modules/@openai/codex /usr/local/lib/node_modules/@openai/codex
RUN ln -s /usr/local/lib/node_modules/@openai/codex/bin/codex.js /usr/local/bin/codex

COPY src/ /app/src/
WORKDIR /app
RUN mkdir -p /app/outputs && chmod 0777 /app/outputs
